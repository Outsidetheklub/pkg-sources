#!/usr/bin/env bash
#
# pkg-sources — show where your installed software comes from.
#
# Detects which package managers exist instead of assuming a distro:
#   pacman [repo]    Arch — official or custom repositories (core, extra, …)
#   AUR              Arch User Repository (batched AUR RPC lookup)
#   local            foreign packages that are not in the AUR
#   apt [repo]       Debian/Ubuntu — archive, or a third-party repo by host
#   apt [local]      installed by hand (dpkg -i, a stray .deb)
#   flatpak [remote] any — shows the remote
#   snap             any — if snapd is installed
#
# Usage:
#   pkg-sources                 explicit installs only (the default)
#   pkg-sources --all           everything, dependencies included
#   pkg-sources --dep           only packages installed as dependencies
#   pkg-sources --no-dep        only explicit installs (same as the default)
#   pkg-sources --gui           only apps with a .desktop launcher
#   pkg-sources --aur           only AUR packages (Arch only)
#   pkg-sources --source WORD   only packages from a matching source
#                               (substring: extra, aur, flathub, nvidia, …)
#   pkg-sources --count         summary: how many packages per source
#   pkg-sources --json          machine-readable output (JSON array)
#   pkg-sources --no-aur-check  skip the AUR API lookup (offline use)
#
# A dependency is not something you chose, and it is most of a normal install
# (285 of 1238 packages here), which is why the default hides them.
#
# Exit status: 0 on success, 1 on error.
set -uo pipefail

VERSION="1.1.0"

# ----------------------------------------------------------------------
# Helpers
# ----------------------------------------------------------------------

die() { echo "pkg-sources: $*" >&2; exit 1; }

usage() {
    # keep in sync with the header block above
    sed -n '3,28p' "$0" | sed 's/^# \{0,1\}//'
    echo
    echo "Version $VERSION — MIT licensed."
}

have() { command -v "$1" >/dev/null 2>&1; }

# ----------------------------------------------------------------------
# Options
# ----------------------------------------------------------------------

MODE="full"        # full | gui | aur
FILTER=""          # --source substring filter
COUNT_ONLY=0
JSON=0
AUR_CHECK=1
DEP_ONLY=0         # --dep: only packages pulled in as dependencies
NODEP_ONLY=1       # default: only explicitly installed packages (see --all)
ALL_PKGS=0         # --all: no dependency filtering at all

while [[ $# -gt 0 ]]; do
    case "$1" in
        --gui)          MODE="gui" ;;
        --aur)          MODE="aur" ;;
        --source)       shift; FILTER="${1:-}" ;;
        --count)        COUNT_ONLY=1 ;;
        --json)         JSON=1 ;;
        --no-aur-check) AUR_CHECK=0 ;;
        --dep)          DEP_ONLY=1; NODEP_ONLY=0; ALL_PKGS=0 ;;
        --no-dep)       NODEP_ONLY=1; DEP_ONLY=0; ALL_PKGS=0 ;;
        --all)          ALL_PKGS=1; DEP_ONLY=0; NODEP_ONLY=0 ;;
        -h|--help)      usage; exit 0 ;;
        --version)      echo "pkg-sources $VERSION"; exit 0 ;;
        *)              die "unknown option: $1 (try --help)" ;;
    esac
    shift
done

have pacman || have dpkg-query || \
    die "no supported package manager found (need pacman or dpkg)"
SELF_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
BACKEND_DIR="$SELF_DIR/backends"

# --aur is an Arch concept. Failing loudly beats returning an empty list.
if [[ "$MODE" == "aur" ]] && ! have pacman; then
    die "--aur needs pacman: the AUR is Arch-only, and this system has no pacman."
fi

# ----------------------------------------------------------------------
# Data collection
# ----------------------------------------------------------------------

declare -A SRC_OF      # package name -> source string
declare -A VER_OF      # package name -> version

# -- pacman: repo map from sync databases (one fast call) ---------------
declare -A REPO_OF
while read -r repo pkg _; do
    [[ -n "${REPO_OF[$pkg]:-}" ]] || REPO_OF[$pkg]="$repo"
done < <(pacman -Sl 2>/dev/null)

# -- pacman: native (official repo) packages ----------------------------
while read -r pkg ver; do
    VER_OF[$pkg]="$ver"
    SRC_OF[$pkg]="pacman [${REPO_OF[$pkg]:-unknown repo}]"
done < <(pacman -Qn 2>/dev/null)

# -- foreign packages: split into AUR vs local --------------------------
# Names AND versions come from a single `pacman -Qm` pass. (The old loop
# ran `pacman -Qm "$pkg"` once per foreign package — ~0.4s of pacman
# startup each — which was 80% of the runtime.)
FOREIGN=()
while read -r pkg ver; do
    FOREIGN+=( "$pkg" )
    VER_OF[$pkg]="$ver"
done < <(pacman -Qm 2>/dev/null)

declare -A IS_AUR
if (( ${#FOREIGN[@]} )); then
    if (( AUR_CHECK )) && have curl && have jq; then
        # Batch query the AUR RPC API (max 500 names per request)
        for (( i = 0; i < ${#FOREIGN[@]}; i += 500 )); do
            chunk=( "${FOREIGN[@]:i:500}" )
            args=()
            for p in "${chunk[@]}"; do
                args+=( --data-urlencode "arg[]=$p" )
            done
            while read -r p; do
                [[ -n "${p:-}" ]] && IS_AUR[$p]=1
            done < <(
                curl -fsS --max-time 15 \
                    "${args[@]}" \
                    "https://aur.archlinux.org/rpc/v5/info" 2>/dev/null |
                    jq -r '.results[] | .Name' 2>/dev/null
            )
        done
        for pkg in "${FOREIGN[@]}"; do
            if [[ -n "${IS_AUR[$pkg]:-}" ]]; then
                SRC_OF[$pkg]="AUR"
            else
                SRC_OF[$pkg]="local"
            fi
        done
    else
        for pkg in "${FOREIGN[@]}"; do
            SRC_OF[$pkg]="foreign (unverified)"
        done
    fi
fi

# -- explicit vs dependency ---------------------------------------------
# One `pacman -Qe` call gives the manually-installed set; everything else
# was pulled in as a dependency. apt delivers the same signal per row via
# `apt-mark showmanual` (field 5 of the backend rows).
declare -A EXPLICIT_OF
if have pacman; then
    while read -r pkg _; do
        [[ -n "${pkg:-}" ]] && EXPLICIT_OF[$pkg]="y"
    done < <(pacman -Qe 2>/dev/null)
fi

# -- flatpak -------------------------------------------------------------
if have flatpak; then
    while IFS=$'\t' read -r appid ver name origin; do
        [[ -n "${appid:-}" ]] || continue
        name="${name:-$appid}"
        VER_OF[$name]="${ver:-}"
        SRC_OF[$name]="flatpak [${origin:-unknown}]"
        EXPLICIT_OF[$name]="y"
    done < <(flatpak list --app --columns=application,version,name,origin 2>/dev/null)
fi

# -- snap ----------------------------------------------------------------
if have snap; then
    while read -r name ver _rev _; do
        [[ "$name" == "Name" || -z "${name:-}" ]] && continue
        VER_OF[$name]="${ver:-}"
        SRC_OF[$name]="snap"
        EXPLICIT_OF[$name]="y"
    done < <(snap list 2>/dev/null)
fi

# -- extra backends: apt today, dnf/zypper/apk later ---------------------
# Each backend is a sourced function library that prints rows of
#     name <TAB> version <TAB> source <TAB> kind <TAB> explicit
# and is skipped entirely when its package manager is absent.
if [[ -d "$BACKEND_DIR" ]]; then
    for _backend in "$BACKEND_DIR"/*.sh; do
        [[ -e "$_backend" ]] || continue
        . "$_backend"
    done
fi

if declare -F collect_apt >/dev/null 2>&1 && have dpkg-query; then
    while IFS=$'\t' read -r _n _v _src _kind _exp; do
        [[ -n "${_n:-}" ]] || continue
        # never clobber an entry another backend already classified
        [[ -n "${SRC_OF[$_n]:-}" ]] && continue
        VER_OF[$_n]="${_v:-}"
        SRC_OF[$_n]="apt [${_src}]"
        EXPLICIT_OF[$_n]="${_exp:-y}"
    done < <(collect_apt 2>/dev/null)
fi

# -- gui mode: .desktop launchers ----------------------------------------
# Reuses the data above where possible. Ownership is resolved with ONE
# bulk `pacman -Qo f1 f2 ...` call — the old per-file loop paid ~0.13s
# of pacman startup for every .desktop file (that was the 25s).
declare -A GUI_APPS
declare -A GUI_VER
if [[ "$MODE" == "gui" ]]; then
    mapfile -t DESKTOPS < <(
        find /usr/share/applications \
             "$HOME/.local/share/applications" \
             /var/lib/flatpak/exports/share/applications \
             "$HOME/.local/share/flatpak/exports/share/applications" \
             \( -type f -o -type l \) -name '*.desktop' 2>/dev/null
    )
    if (( ${#DESKTOPS[@]} )); then
        # One pass: file -> display name (first Name= per file)
        declare -A NAME_OF
        while IFS=$'\t' read -r file name; do
            NAME_OF[$file]="$name"
        done < <(
            awk '/^Name=/{sub(/^Name=/,""); print FILENAME "\t" $0; nextfile}' \
                "${DESKTOPS[@]}" 2>/dev/null
        )

        # One bulk call: file -> owning package. Both managers accept many paths
        # at once, which is the whole point — per-file calls cost one process
        # start each, and that was the original 25 s.
        declare -A OWNER_OF
        if have pacman; then
            while IFS= read -r line; do
                file="${line%% is owned by *}"
                owner="${line#* is owned by }"
                owner="${owner%% *}"
                [[ -n "$file" && -n "$owner" ]] || continue
                OWNER_OF[$file]="$owner"
            done < <(pacman -Qo "${DESKTOPS[@]}" 2>/dev/null)
        elif have dpkg; then
            # dpkg -S prints "pkg: /path"; several packages are comma separated
            while IFS= read -r line; do
                owner="${line%%:*}"
                path="${line#*: }"
                [[ -n "$owner" && -n "$path" ]] || continue
                for d in "${DESKTOPS[@]}"; do
                    if [[ "$d" == "$path" ]]; then OWNER_OF[$d]="$owner"; break; fi
                done
            done < <(dpkg -S "${DESKTOPS[@]}" 2>/dev/null)
        fi

        for file in "${DESKTOPS[@]}"; do
            name="${NAME_OF[$file]:-}"
            [[ -n "$name" ]] || continue
            owner="${OWNER_OF[$file]:-}"

            # Known by display name (flatpak / snap / ...)?
            if [[ -n "${SRC_OF[$name]:-}" ]]; then
                GUI_APPS[$name]="${SRC_OF[$name]}"
                GUI_VER[$name]="${VER_OF[$name]:-}"
            # Owned by a pacman package we already classified?
            elif [[ -n "$owner" && -n "${SRC_OF[$owner]:-}" ]]; then
                GUI_APPS[$name]="${SRC_OF[$owner]}"
                GUI_VER[$name]="${VER_OF[$owner]:-}"
            elif [[ -z "${GUI_APPS[$name]:-}" ]]; then
                # Never downgrade an app another .desktop already classified:
                # packaged apps often also ship a userapp-*.desktop copy in
                # ~/.local/share/applications, which has no owning package.
                GUI_APPS[$name]="local"
            fi
        done
    fi
fi

# ----------------------------------------------------------------------
# Output
# ----------------------------------------------------------------------

# Build the entry list based on mode
declare -A OUT_SRC; declare -A OUT_VER
if [[ "$MODE" == "gui" ]]; then
    for name in "${!GUI_APPS[@]}"; do
        OUT_SRC[$name]="${GUI_APPS[$name]}"
        OUT_VER[$name]="${GUI_VER[$name]:-}"
    done
else
    for name in "${!SRC_OF[@]}"; do
        OUT_SRC[$name]="${SRC_OF[$name]}"
        OUT_VER[$name]="${VER_OF[$name]:-}"
    done
fi

# Apply --source filter
if [[ -n "$FILTER" ]]; then
    for name in "${!OUT_SRC[@]}"; do
        case "${OUT_SRC[$name],,}" in
            *"${FILTER,,}"*) ;;
            *) unset 'OUT_SRC[$name]' 'OUT_VER[$name]' ;;
        esac
    done
fi

# Apply --dep / --no-dep (snapshot the keys: unsetting while iterating an
# associative array is asking for trouble)
if (( (DEP_ONLY || NODEP_ONLY) && ! ALL_PKGS )); then
    mapfile -t _keys < <(printf '%s\n' "${!OUT_SRC[@]}")
    for name in "${_keys[@]}"; do
        [[ -z "${name:-}" ]] && continue
        _exp="${EXPLICIT_OF[$name]:-y}"
        if (( DEP_ONLY )) && [[ "$_exp" != "n" ]]; then
            unset 'OUT_SRC[$name]' 'OUT_VER[$name]'
        fi
        if (( NODEP_ONLY )) && [[ "$_exp" != "y" ]]; then
            unset 'OUT_SRC[$name]' 'OUT_VER[$name]'
        fi
    done
fi

# Apply --aur shortcut
if [[ "$MODE" == "aur" ]]; then
    for name in "${!OUT_SRC[@]}"; do
        [[ "${OUT_SRC[$name]}" == "AUR" ]] || unset 'OUT_SRC[$name]' 'OUT_VER[$name]'
    done
fi

(( ${#OUT_SRC[@]} )) || { echo "No packages matched."; exit 0; }

# --count
if (( COUNT_ONLY )); then
    declare -A COUNTS
    for name in "${!OUT_SRC[@]}"; do
        COUNTS[${OUT_SRC[$name]}]="$(( ${COUNTS[${OUT_SRC[$name]}]:-0} + 1 ))"
    done
    printf '%-24s %s\n' "SOURCE" "COUNT"
    printf '%-24s %s\n' "------------------------" "-----"
    for src in "${!COUNTS[@]}"; do
        printf '%-24s %s\n' "$src" "${COUNTS[$src]}"
    done | sort -f
    total="${#OUT_SRC[@]}"
    echo
    printf '%-24s %s\n' "TOTAL" "$total"
    exit 0
fi

# --json
if (( JSON )); then
    for name in "${!OUT_SRC[@]}"; do
        printf '%s\t%s\t%s\n' "$name" "${OUT_VER[$name]}" "${OUT_SRC[$name]}"
    done | sort -f | jq -nR '[inputs | split("\t") |
        {name: .[0], version: .[1], source: .[2]}]'
    exit 0
fi

# -- grouped table (default)
while IFS= read -r src; do
    count=0
    entries=()
    for name in "${!OUT_SRC[@]}"; do
        if [[ "${OUT_SRC[$name]}" == "$src" ]]; then
            count=$(( count + 1 ))
            entries+=( "$name" )
        fi
    done
    printf '\n== %s (%d) ==\n' "$src" "$count"
    while IFS= read -r name; do
        printf '  %-40s %s\n' "$name" "${OUT_VER[$name]}"
    done < <(printf '%s\n' "${entries[@]}" | sort -f)
done < <(printf '%s\n' "${OUT_SRC[@]}" | sort -fu)
echo
printf '%d packages total.\n' "${#OUT_SRC[@]}"
